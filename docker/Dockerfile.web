FROM node:20-alpine AS base
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
RUN pnpm install --filter @procureai/web... --frozen-lockfile=false
COPY . .
RUN pnpm --filter @procureai/web build
CMD ["pnpm", "--filter", "@procureai/web", "start"]
